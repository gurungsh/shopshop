{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-api-.clef",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "identity-admin-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/users/{**catch-all}" }
      },
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "catalog-admin-products": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/products/{**catch-all}" }
      },
      "catalog-admin-categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/categories/{**catch-all}" }
      },
      "ordering-orders": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "ordering-admin-orders": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/admin/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "identity-1": { "Address": "https://localhost:7244" } }
      },
      "catalog": {
        "Destinations": { "catalog-1": { "Address": "https://localhost:7151" } }
      },
      "ordering": {
        "Destinations": { "ordering-1": { "Address": "https://localhost:7055" } }
      }
    }
  }
}