{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "docs-identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/docs/identity/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "docs-catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/docs/catalog/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "docs-ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/docs/ordering/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "identity-1": { "Address": "https://localhost:7244" } }
      },
      "catalog": {
        "Destinations": { "catalog-1": { "Address": "https://localhost:7151" } }
      },
      "ordering": {
        "Destinations": { "ordering-1": { "Address": "https://localhost:7055" } }
      }
    }
  }
}